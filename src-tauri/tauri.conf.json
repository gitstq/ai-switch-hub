{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Switch Hub",
  "version": "1.0.0",
  "identifier": "com.aiswitchhub.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Switch Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "gitstq",
    "homepage": "https://github.com/gitstq/ai-switch-hub",
    "shortDescription": "Unified management for AI CLI tools",
    "longDescription": "AI Switch Hub is a cross-platform desktop application for managing multiple AI coding CLI tools including Claude Code, Codex, Gemini CLI, OpenCode, and OpenClaw.",
    "category": "DeveloperTool",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "license": "../LICENSE",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [],
      "pubkey": ""
    }
  }
}
